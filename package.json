{
  "name": "skillspring",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3010",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0 --port 3010",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --project demo-skillspring --only firestore 'vitest run tests/rules.test.ts'",
    "emulators": "firebase emulators:start --project demo-skillspring --only auth,firestore",
    "local": "node scripts/local.mjs",
    "seed:local": "tsx scripts/seed-local.ts"
  },
  "dependencies": {
    "cloudinary": "^2.7.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.468.0",
    "luxon": "^3.7.0",
    "motion": "^12.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "@types/luxon": "^3.7.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "firebase-tools": "^15.34.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
