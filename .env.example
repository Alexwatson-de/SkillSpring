# Public Firebase web app configuration. No privileged credentials here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server only: same project; dedicated datastore.user + firebaseauth.viewer identity.
FIREBASE_PROJECT_ID=
# Use a secure absolute credential path locally OR JSON in protected host secrets.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional profile image provider. Existing configured account may be reused.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Hosting URL, used for verification/reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3010
# Local emulators only; never set these on a deployed host.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9101
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9101
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8101
